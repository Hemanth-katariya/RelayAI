// RelayAI — Prisma schema
// Core entities: PolicyDoc, Customer, Order, Thread, Message, AgentDecision

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Knowledge base — retrieved via vector search (pgvector) during the
// "retrieve policy" step of the agent pipeline.
// ---------------------------------------------------------------------------
model PolicyDoc {
  id        String   @id @default(cuid())
  title     String
  category  String   // e.g. "refunds", "shipping", "returns", "billing"
  content   String   @db.Text
  // embedding stored via raw SQL / pgvector extension (Unsupported type
  // placeholder — Prisma doesn't natively type vector columns yet)
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now())

  agentDecisions AgentDecisionPolicyDoc[]
}

// ---------------------------------------------------------------------------
// Mock "backend system" data — looked up via a tool call during the
// "look up customer/order" step.
// ---------------------------------------------------------------------------
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  orders  Order[]
  threads Thread[]
}

enum OrderStatus {
  DELIVERED
  IN_TRANSIT
  DELAYED
  CANCELLED
  RETURNED
}

model Order {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  itemName       String
  amount         Float
  orderDate      DateTime
  deliveryDate   DateTime?
  status         OrderStatus
  // Derived at seed time from orderDate/status + the return-window policy,
  // so the agent's "decide allowed action" step has real eligibility data
  // to reason over instead of guessing.
  refundEligible Boolean

  threads Thread[]
}

// ---------------------------------------------------------------------------
// Conversation + pipeline state
// ---------------------------------------------------------------------------
enum ThreadStatus {
  OPEN
  PENDING_HUMAN_REVIEW
  RESOLVED
  ESCALATED
}

model Thread {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id])
  subject    String
  status     ThreadStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  messages       Message[]
  agentDecisions AgentDecision[]
}

enum MessageSender {
  CUSTOMER
  AGENT
  HUMAN
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    Thread        @relation(fields: [threadId], references: [id])
  sender    MessageSender
  body      String        @db.Text
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Audit log — one row per agent pipeline run on a message. This is what
// the evaluation script reads to compute accuracy/precision/recall, and
// what the HITL UI shows as the "reasoning trail".
// ---------------------------------------------------------------------------
enum AllowedAction {
  APPROVE_REFUND
  DENY_REFUND
  RESEND_TRACKING_INFO
  ESCALATE_TO_HUMAN
  GENERAL_REPLY
}

enum RiskLevel {
  LOW
  HIGH
}

enum HumanAction {
  APPROVED
  EDITED
  REJECTED
  NOT_REQUIRED
}

model AgentDecision {
  id                String        @id @default(cuid())
  threadId          String
  thread            Thread        @relation(fields: [threadId], references: [id])
  messageId         String        @unique

  intent            String        // e.g. "refund_request", "delivery_complaint"
  sentiment         String        // e.g. "neutral", "frustrated", "angry"
  urgency           String        // e.g. "low", "medium", "high"

  retrievedPolicyDocs PolicyDoc[] @relation("AgentDecisionPolicyDoc")

  orderLookupResult String?       @db.Text  // serialized snapshot of order data used

  proposedAction    AllowedAction
  riskLevel         RiskLevel
  confidence        Float         // 0.0–1.0, self-reported by the LLM

  draftResponse     String        @db.Text
  autoExecuted      Boolean       @default(false)
  humanAction       HumanAction   @default(NOT_REQUIRED)
  finalResponse     String?       @db.Text

  createdAt         DateTime      @default(now())
}

// Explicit join model name for the many-to-many relation above
model AgentDecisionPolicyDoc {
  agentDecisionId String
  policyDocId     String

  @@id([agentDecisionId, policyDocId])
}
